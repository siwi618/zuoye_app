{
  // Cloudflare Worker that wraps the FastAPI container.
  // Docs: https://developers.cloudflare.com/containers/
  "name": "zuoyebang-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],

  // Served on our own domain: *.workers.dev is unreliable from mainland China.
  // The workers.dev address stays enabled as a fallback.
  "routes": [{ "pattern": "api.studycoral.com", "custom_domain": true }],

  "containers": [
    {
      "class_name": "ZuoyebangBackend",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CONTAINER",
        "class_name": "ZuoyebangBackend"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ZuoyebangBackend"]
    }
  ],

  // Non-secret env vars exposed to the container.
  // CORS_ORIGINS is a comma-separated list — pydantic-settings splits it
  // into list[str] when JSON-decoding fails. Plain commas survive the
  // Worker→Container env-var hop unmangled.
  // Every 10 min: re-moderate content saved while OpenAI was unreachable.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },

  "vars": {
    "ENVIRONMENT": "production",
    // "false" turns off video uploads (images keep working). Push to redeploy.
    "MEDIA_VIDEO_ENABLED": "true",
    "CORS_ORIGINS": "https://studycoral.com,https://www.studycoral.com,https://zuoyebang-app.pages.dev,http://localhost:3000"
  }

  // Secrets (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY)
  // are set via `wrangler secret put` — never committed.
}
