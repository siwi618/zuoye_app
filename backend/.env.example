# Copy this file to .env and fill in real values. NEVER commit .env.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

ENVIRONMENT=development

# Optional. Leave empty to use the environment default
# (development → http://localhost:3000, http://localhost:5173;
#  production  → https://zuoyebang-app.pages.dev).
# Override with a comma-separated list when needed, e.g.:
#   CORS_ORIGINS=http://localhost:3000,https://staging.example.com
# CORS_ORIGINS=
# Optional: content moderation (OpenAI omni-moderation, free). Empty = moderation off.
OPENAI_API_KEY=
